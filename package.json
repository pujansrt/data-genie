{
  "name": "@pujansrt/data-genie",
  "version": "2.1.0",
  "homepage": "https://pujansrt.github.io/data-genie/",
  "keywords": [
    "typescript",
    "etl",
    "engine",
    "data",
    "processing",
    "performance",
    "pipeline",
    "transformations",
    "data-genie",
    "data-engine",
    "data-pipeline",
    "data-transformation"
  ],
  "license": "MIT",
  "description": "High performant ETL engine written in TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage && jest-coverage-badges --input ./coverage/coverage-summary.json --output ./badges",
    "dev": "tsup --watch",
    "build": "tsup",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pujansrt/data-genie.git"
  },
  "author": "Pujan Srivastava",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-storage": "^3.1037.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "exceljs": "^4.4.0",
    "jest": "^30.0.3",
    "jest-coverage-badges": "^1.1.2",
    "parquetjs-lite": "^0.8.7",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "vitepress": "^1.6.4",
    "zod": "^4.3.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts",
      "!src/examples/**/*"
    ]
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "mermaid": "^11.14.0",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "exceljs": "^4.0.0",
    "parquetjs-lite": "^0.8.7",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "parquetjs-lite": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
